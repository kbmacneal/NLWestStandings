@using NLWestStandings.Client.Classes.PlayByPlay
@implements IDisposable

@if (Linescore?.defense is not null)
{
    var d = Linescore.defense;
    var o = Linescore.offense;
    var replayMode = ReplayPlays.Length > 0;
    var activePlay = ActiveReplayPlay;
    <svg class="diamond-svg" viewBox="0 0 400 380" role="img" aria-label="@(replayMode ? "Baseball play replay" : "Live baseball diamond")">
        <rect x="0" y="0" width="400" height="380" rx="8" class="diamond-grass" />
        <polygon points="200,330 340,190 200,50 60,190" class="diamond-infield" />
        <polygon points="200,310 320,190 200,70 80,190" class="diamond-dirt" />
        <line x1="200" y1="330" x2="20" y2="150" class="diamond-line" />
        <line x1="200" y1="330" x2="380" y2="150" class="diamond-line" />

        @* bases *@
        <rect x="190" y="60" width="20" height="20" class="@(replayMode ? ReplayBaseClass("2B") : BaseClass(o?.second))" transform="rotate(45 200 70)" />
        <rect x="310" y="180" width="20" height="20" class="@(replayMode ? ReplayBaseClass("1B") : BaseClass(o?.first))" transform="rotate(45 320 190)" />
        <rect x="70" y="180" width="20" height="20" class="@(replayMode ? ReplayBaseClass("3B") : BaseClass(o?.third))" transform="rotate(45 80 190)" />
        <polygon points="190,320 210,320 210,330 200,340 190,330" class="diamond-base" />

        @* defenders *@
        @Player(200, 190, replayMode ? activePlay?.matchup?.pitcher?.fullName : d.pitcher?.fullName, "P", "diamond-defender")
        @Player(200, 355, d.catcher?.fullName, "C", "diamond-defender")
        @Player(320, 160, d.first?.fullName, "1B", "diamond-defender")
        @Player(255, 100, d.second?.fullName, "2B", "diamond-defender")
        @Player(145, 100, d.shortstop?.fullName, "SS", "diamond-defender")
        @Player(80, 160, d.third?.fullName, "3B", "diamond-defender")
        @Player(70, 35, d.left?.fullName, "LF", "diamond-defender")
        @Player(200, 20, d.center?.fullName, "CF", "diamond-defender")
        @Player(330, 35, d.right?.fullName, "RF", "diamond-defender")

        @* runners and batter *@
        @if (!replayMode)
        {
            @if (o?.first is not null) { @Player(335, 215, o.first.fullName, "R", "diamond-runner") }
            @if (o?.second is not null) { @Player(200, 90, o.second.fullName, "R", "diamond-runner") }
            @if (o?.third is not null) { @Player(65, 215, o.third.fullName, "R", "diamond-runner") }
            @if (o?.batter is not null) { @Player(250, 335, o.batter.fullName, "B", "diamond-batter") }
        }
        else
        {
            @foreach (var runner in ReplayRunners)
            {
                @ReplayRunner(runner)
            }
            @if (activePlay?.matchup?.batter is not null &&
                 (ReplayTickIndex < 0 || !activePlay.about.isComplete) &&
                 !ReplayRunners.Any(runner => runner.Id == activePlay.matchup.batter.id))
            {
                @Player(250, 335, activePlay.matchup.batter.fullName, "B", "diamond-batter", activePlay.matchup.batter.id)
            }
        }
    </svg>
    @if (replayMode)
    {
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2" aria-live="polite">
            @if (ReplayTickIndex >= 0 && activePlay is not null)
            {
                <span>Play @(ReplayTickIndex + 1) of @ReplayPlays.Length: @activePlay.result?.description (@($"{activePlay.result?.awayScore} - {activePlay.result?.homeScore}"))</span>
            }
            else if (ReplayComplete)
            {
                <span>Replay complete: @ReplayPlays[^1].result?.description</span>
            }
            else
            {
                <span>Ready to replay @ReplayPlays.Length plays through the current play</span>
            }
        </MudText>
    }
}

@code {
    [Parameter]
    public Linescore? Linescore { get; set; }

    [Parameter]
    public Allplay[] ReplayPlays { get; set; } = Array.Empty<Allplay>();

    [Parameter]
    public int ReplayRequest { get; set; }

    [Parameter]
    public int TickIntervalMs { get; set; } = 1000;

    private CancellationTokenSource? _replayCancellation;
    private int _lastReplayRequest = -1;
    private int _lastTickIntervalMs = 1000;
    private int ReplayTickIndex { get; set; } = -1;
    private bool ReplayComplete { get; set; }
    private TaskCompletionSource _intervalChanged = NewIntervalSignal();
    private Allplay? ActiveReplayPlay => ReplayPlays.Length == 0
        ? null
        : ReplayPlays[Math.Clamp(ReplayTickIndex, 0, ReplayPlays.Length - 1)];
    private ReplayRunnerState[] ReplayRunners => BuildReplayRunners();

    protected override void OnParametersSet()
    {
        if (_lastTickIntervalMs != TickIntervalMs)
        {
            _lastTickIntervalMs = TickIntervalMs;
            var previousSignal = _intervalChanged;
            _intervalChanged = NewIntervalSignal();
            previousSignal.TrySetResult();
        }

        if (_lastReplayRequest == ReplayRequest)
        {
            return;
        }

        _lastReplayRequest = ReplayRequest;
        _replayCancellation?.Cancel();
        _replayCancellation?.Dispose();
        _replayCancellation = new CancellationTokenSource();
        ReplayTickIndex = -1;
        ReplayComplete = false;
        _ = RunReplayAsync(_replayCancellation.Token);
    }

    private static TaskCompletionSource NewIntervalSignal() =>
        new(TaskCreationOptions.RunContinuationsAsynchronously);

    private static string BaseClass(object? runner) => runner is null ? "diamond-base" : "diamond-base diamond-base-occupied";

    private string ReplayBaseClass(string baseName)
    {
        return ReplayRunners.Any(runner => string.Equals(runner.Base, baseName, StringComparison.OrdinalIgnoreCase))
            ? "diamond-base diamond-base-occupied"
            : "diamond-base";
    }

    private ReplayRunnerState[] BuildReplayRunners()
    {
        var play = ActiveReplayPlay;
        if (play is null)
        {
            return Array.Empty<ReplayRunnerState>();
        }

        var runners = new Dictionary<int, ReplayRunnerState>();
        AddStartingRunner(runners, play.matchup?.postOnFirst?.id, play.matchup?.postOnFirst?.fullName, "1B");
        AddStartingRunner(runners, play.matchup?.postOnSecond?.id, play.matchup?.postOnSecond?.fullName, "2B");
        AddStartingRunner(runners, play.matchup?.postOnThird?.id, play.matchup?.postOnThird?.fullName, "3B");

        if (ReplayTickIndex >= 0)
        {
            foreach (var group in (play.runners ?? Array.Empty<Runner2>())
                         .Where(runner => runner.details?.runner is not null)
                         .GroupBy(runner => runner.details!.runner!.id))
            {
                var runner = group.First().details!.runner!;
                runners.Remove(runner.id);

                var movement = group.Last().movement;
                var endBase = movement?.end;
                if (movement?.isOut != true &&
                    !string.IsNullOrWhiteSpace(endBase) &&
                    !endBase.Equals("score", StringComparison.OrdinalIgnoreCase) &&
                    !endBase.Equals("home", StringComparison.OrdinalIgnoreCase))
                {
                    runners[runner.id] = new ReplayRunnerState(runner.id, runner.fullName, endBase);
                }
            }
        }

        return runners.Values.ToArray();
    }

    private static void AddStartingRunner(Dictionary<int, ReplayRunnerState> runners, int? id, string? name, string baseName)
    {
        if (id is not null)
        {
            runners[id.Value] = new ReplayRunnerState(id.Value, name, baseName);
        }
    }

    private RenderFragment ReplayRunner(ReplayRunnerState runner)
    {
        var (x, y) = BasePoint(runner.Base);
        if (x < 0)
        {
            return builder => { };
        }

        return Player(x, y, runner.FullName, "R", "diamond-runner", runner.Id);
    }

    private static (int X, int Y) BasePoint(string baseName) => baseName.ToUpperInvariant() switch
    {
        "1B" or "FIRST" => (335, 215),
        "2B" or "SECOND" => (200, 90),
        "3B" or "THIRD" => (65, 215),
        _ => (-100, -100)
    };

    private async Task RunReplayAsync(CancellationToken cancellationToken)
    {
        try
        {
            for (var i = 0; i < ReplayPlays.Length; i++)
            {
                cancellationToken.ThrowIfCancellationRequested();
                ReplayTickIndex = i;
                await InvokeAsync(StateHasChanged);
                await WaitForNextPlayAsync(cancellationToken);
            }

            cancellationToken.ThrowIfCancellationRequested();
            ReplayComplete = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task WaitForNextPlayAsync(CancellationToken cancellationToken)
    {
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        while (true)
        {
            var interval = Math.Clamp(TickIntervalMs, 250, 5000);
            var remaining = interval - (int)System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds;
            if (remaining <= 0)
            {
                return;
            }

            var intervalChanged = _intervalChanged.Task;
            var delay = Task.Delay(remaining, cancellationToken);
            var completedTask = await Task.WhenAny(delay, intervalChanged);
            if (completedTask == delay)
            {
                await delay;
                return;
            }

            await intervalChanged;
        }
    }

    private RenderFragment Player(int x, int y, string? name, string label, string cssClass, object? key = null) => @<g @key="key">
        <title>@name</title>
        <circle cx="@x" cy="@y" r="13" class="@cssClass" style="@($"transition:cx {Math.Clamp(TickIntervalMs, 250, 5000)}ms ease,cy {Math.Clamp(TickIntervalMs, 250, 5000)}ms ease")" />
        <text x="@x" y="@(y + 4)" text-anchor="middle" class="diamond-label">@label</text>
        <text x="@x" y="@(y + 27)" text-anchor="middle" class="diamond-name">@Short(name)</text>
    </g>;

    private static string Short(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
        while (parts.Count > 1 && Suffixes.Contains(parts[^1].TrimEnd('.')))
        {
            parts.RemoveAt(parts.Count - 1);
        }

        return parts.Count > 1 ? $"{parts[^1]}" : name;
    }

    private static readonly HashSet<string> Suffixes = new(StringComparer.OrdinalIgnoreCase) { "Jr", "Sr", "II", "III", "IV", "V" };
    private sealed record ReplayRunnerState(int Id, string? FullName, string Base);

    public void Dispose()
    {
        _replayCancellation?.Cancel();
        _replayCancellation?.Dispose();
        _intervalChanged.TrySetCanceled();
    }
}
