@using Flurl.Http
@using NLWestStandings.Client.Classes
@using NLWestStandings.Client.Classes.PlayByPlay
@using System.Globalization
@using System.Net.WebSockets
@using StatsAPI
@using Websocket.Client
@implements IAsyncDisposable;
@inject Blazored.LocalStorage.ISyncLocalStorageService localStorage
@inject StatsAPI.Client client

<style>
    .table {
    display: table;
    width: 100%;
    table-layout: fixed;
    }

    .table_cell {
    display: table-cell;
    width: 5%;
    border: solid black 1px;
    text-align: center;
    }
</style>

@{
    var currentPlay = playByPlay?.LiveData?.Plays?.CurrentPlay;
    var innings = playByPlay?.LiveData?.Linescore?.Innings?.OrderBy(e => e.Num) ?? Enumerable.Empty<InningRestObject>();
    var awayTotals = playByPlay?.LiveData?.Linescore?.Teams?.Away;
    var homeTotals = playByPlay?.LiveData?.Linescore?.Teams?.Home;
    var probableHome = playByPlay?.GameData?.ProbablePitchers?.Home;
    var probableAway = playByPlay?.GameData?.ProbablePitchers?.Away;
    var weather = playByPlay?.GameData?.Weather;
}

@if (playByPlay is not null)
{
    @if (showheader)
    {
        <MudText Class="m-auto" Typo="Typo.h3">@gamename - @(playByPlay.GameData?.Datetime?.OfficialDate.ToString() ?? "N/A")</MudText>

        @if (currentPlay is not null)
        {
            <MudText Class="m-auto" Typo="Typo.h5">Current: @myTI.ToTitleCase(currentPlay.About?.HalfInning ?? "") @(currentPlay.About?.Inning ?? 0)</MudText>
        }
        else
        {
            <MudText Class="m-auto" Typo="Typo.h5">N/A</MudText>
        }

        @if (probableHome is not null && probableAway is not null)
        {
            <MudText Class="m-auto" Typo="Typo.h5"><MudImage Class="rounded-lg" Height="25" Width="25" Src="@SVGLogo.GetLogo(hometeam, dark_mode)"></MudImage> @probableHome.FullName vs. <MudImage Class="rounded-lg" Height="25" Width="25" Src="@SVGLogo.GetLogo(awayteam, dark_mode)"></MudImage> @probableAway.FullName</MudText>
        }
        else
        {
            <MudText Class="m-auto" Typo="Typo.h5">N/A</MudText>
        }

        @if (weather is not null)
        {
            <MudText Class="m-auto" Typo="Typo.h5">@weather.Temp °F, @weather.Condition, @weather.Wind</MudText>
        }
        else
        {
            <MudText Class="m-auto" Typo="Typo.h5">N/A</MudText>
        }
    }

    <div class="responsive-table-wrap app-card pa-2">
        <table>
            <caption class="sr-only">Line score by inning</caption>
            <thead>
                <tr>
                    <th scope="col" class="table_cell">Inning</th>
                    @foreach (var inning in innings)
                    {
                        <th scope="col" class="table_cell">@inning.Num</th>
                    }
                    <th scope="col" class="table_cell">Runs</th>
                    <th scope="col" class="table_cell">Hits</th>
                    <th scope="col" class="table_cell">Errors</th>
                    <th scope="col" class="table_cell">LoB</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row" class="table_cell"><MudImage Alt="@($"{awayteam} logo")" Class="rounded-lg" Height="25" Width="25" Src="@SVGLogo.GetLogo(awayteam, dark_mode)"></MudImage></th>
                    @foreach (var inning in innings)
                    {
                        <td class="table_cell">@(inning.Away?.Runs ?? 0)</td>
                    }
                    <td class="table_cell">@(awayTotals?.Runs ?? 0)</td>
                    <td class="table_cell">@(awayTotals?.Hits ?? 0)</td>
                    <td class="table_cell">@(awayTotals?.Errors ?? 0)</td>
                    <td class="table_cell">@(awayTotals?.LeftOnBase ?? 0)</td>
                </tr>
                <tr>
                    <th scope="row" class="table_cell"><MudImage Alt="@($"{hometeam} logo")" Class="rounded-lg" Height="25" Width="25" Src="@SVGLogo.GetLogo(hometeam, dark_mode)"></MudImage></th>
                    @foreach (var inning in innings)
                    {
                        <td class="table_cell">@(inning.Home?.Runs ?? 0)</td>
                    }
                    <td class="table_cell">@(homeTotals?.Runs ?? 0)</td>
                    <td class="table_cell">@(homeTotals?.Hits ?? 0)</td>
                    <td class="table_cell">@(homeTotals?.Errors ?? 0)</td>
                    <td class="table_cell">@(homeTotals?.LeftOnBase ?? 0)</td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}

<br />
<br />
<br />

@code {
    [Parameter]
    public string gamepk { get; set; } = string.Empty;
    [Parameter]
    public bool showheader { get; set; } = true;
    [Parameter]
    public bool liverefresh { get; set; } = true;

    public string hometeam { get; set; } = "N/A";

    public string awayteam { get; set; } = "N/A";

    private string gamename { get; set; } = string.Empty;

    private TextInfo myTI = new CultureInfo("en-US", false).TextInfo;

    private BaseballGameRestObject? playByPlay { get; set; }

    private WebsocketClient? _client { get; set; }

    private string _message = "Gameday5";

    private bool dark_mode { get; set; }

    protected override async Task OnInitializedAsync()
    {

        playByPlay = await GetPlayByPlay(gamepk).ConfigureAwait(false);

        if (playByPlay is null)
        {
            return;
        }

        var teams = playByPlay.GameData?.Teams;
        hometeam = teams is not null && teams.TryGetValue("home", out var homeTeam) ? homeTeam?.Name ?? "N/A" : "N/A";
        awayteam = teams is not null && teams.TryGetValue("away", out var awayTeam) ? awayTeam?.Name ?? "N/A" : "N/A";

        gamename = $"{awayteam} @ {hometeam}";
        var abstractCode = playByPlay?.GameData?.Status?.AdditionalProperties is not null &&
            playByPlay.GameData.Status.AdditionalProperties.TryGetValue("abstractGameCode", out var abstractCodeValue)
            ? Convert.ToString(abstractCodeValue)
            : null;

        if (liverefresh && string.Equals(abstractCode, "L", StringComparison.OrdinalIgnoreCase))
        {
            var url = new Uri($"wss://ws.statsapi.mlb.com/api/v1/game/push/subscribe/gameday/{gamepk}");
            _client = new WebsocketClient(url);
            var socketClient = _client;

            socketClient.Name = "MLB Gameday";
            socketClient.ReconnectTimeout = TimeSpan.FromSeconds(60);
            socketClient.ErrorReconnectTimeout = TimeSpan.FromSeconds(30);
            socketClient.ReconnectionHappened.Subscribe(info =>
            {
                Console.WriteLine($"Reconnection happened, type: {info.Type}, url: {socketClient.Url}");
                socketClient.Send(_message);
                // Log($"Reconnected, type: '{info.Type}'", LogSeverity.Warning);
                // StateHasChanged();
            });
            socketClient.DisconnectionHappened.Subscribe(info =>
            {
                Console.WriteLine($"Disconnection happened, type: {info.Type}");
                // Log($"Disconnected, type: '{info.Type}', reason: '{info.CloseStatus}'", LogSeverity.Warning);
                // StateHasChanged();
            });

            socketClient.MessageReceived.Subscribe(async msg =>
            {
                Console.WriteLine($"Live update received");

                var jsonplay = System.Text.Json.JsonSerializer.Deserialize<PbPPushNotification>(msg.Text ?? "");

                playByPlay = await GetUpdatePlayByPlay(jsonplay?.updateId ?? "").ConfigureAwait(false);

                // Log($"Received: '{msg.Text}'", LogSeverity.Info);
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            });

            await socketClient.Start().ConfigureAwait(false);
        }


        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (localStorage.ContainKey("CurrentMode"))
            {
                dark_mode = localStorage.GetItem<bool>("CurrentMode");
            }
            else
            {
                localStorage.SetItem("CurrentMode", false);
            }

            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_client == null)
            return;

        await _client.Stop(WebSocketCloseStatus.NormalClosure, string.Empty).ConfigureAwait(false);

        _client.Dispose();
    }

    private async Task<BaseballGameRestObject> GetPlayByPlay(string pk)
    {
        try
        {
            return (await client.LiveGameVOneAsync(int.Parse(pk), null, null, null, null).ConfigureAwait(false)).Result;
        }
        catch (Exception)
        {
            throw;
        }

    }

    private async Task<BaseballGameRestObject> GetUpdatePlayByPlay(string updateID)
    {
        try
        {
            return (await client.LiveGameVOneAsync(int.Parse(gamepk), updateID, null, null, null).ConfigureAwait(false)).Result;
        }
        catch (Exception)
        {
            return new();
        }
    }
}